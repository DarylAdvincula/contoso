@model ContosoUniversity.Models.SchoolViewModels.InstructorIndexData

@{
    ViewData["Title"] = "Instructors";

    var prevDisabled = !ViewBag.HasPreviousPage;
    var nextDisabled = !ViewBag.HasNextPage;
}

<h2>Instructors</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Last Name</th>
            <th>First Name</th>
            <th>Hire Date</th>
            <th>Office</th>
            <th>Courses</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Instructors)
        {
            string selectedRow = "";
            if (item.Id == (int?)ViewData["InstructorId"])
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstMidName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HireDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OfficeAssignment!.Location)
                </td>
                <td>
                    @if (item.CourseAssignments.Count() > 0)
                    {
                        @foreach (var course in item.CourseAssignments)
                        {
                            <span>@course.CourseId @course.Course.Title</span> 
                            <br />
                        }
                    }
                    else
                    {
                        <p>No course/s assigned</p>
                    }
                </td>
                <td>
                    <a asp-action="Index" asp-route-id="@item.Id" asp-route-page="@ViewBag.PageNumber">Select</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
           }
    </tbody>
</table>

@if (Model.Courses.Count() > 0)
{
    <h3>Courses Taught by Selected Instructor</h3>
    <table class="table">
        <tr>
            <th></th>
            <th>Number</th>
            <th>Title</th>
            <th>Department</th>
        </tr>

        @foreach (var item in Model.Courses)
        {
            string selectedRow = "";
            if (item.Id == (int?) ViewData["CourseId"])
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>
                    @Html.ActionLink("Select", "Index", new { id = ViewBag.Id, courseId = item.Id, page = ViewBag.PageNumber })
                </td>
                <td>
                    @item.Id
                </td>
                <td>
                    @item.Title
                </td>
                <td>
                    @item.Department!.Name
                </td>
            </tr>
        }
    </table>
}

@if (Model.Enrollments.Count() > 0)
{
    <h3>
        Students Enrolled in Selected Course
    </h3>
    <table class="table">
        <tr>
            <th>Name</th>
            <th>Grade</th>
        </tr>
        @foreach (var item in Model.Enrollments)
        {
            <tr>
                <td>
                    @item.Student!.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Grade)
                </td>
            </tr>
        }
    </table>
}

<p>Page @(ViewBag.PageNumber > 0 ? ViewBag.PageNumber : 0) of @ViewBag.TotalPages</p>

<div class="d-flex gap-2">
    <a asp-controller="Instructors"
       asp-action="Index"
       asp-route-id=""
       asp-route-courseId=""
       asp-route-page="@(ViewBag.PageNumber - 1)"
       class="btn btn-default d-flex gap-2 align-items-center py-1 pe-3 ps-2 @(prevDisabled ? "disabled" : "")">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left-icon lucide-chevron-left"><path d="m15 18-6-6 6-6" /></svg>
        Prev
    </a>
    <a asp-controller="Instructors"
       asp-action="Index"
       asp-route-id=""
       asp-route-courseId=""
       asp-route-page="@(ViewBag.PageNumber + 1)"
       class="btn btn-default d-flex gap-2 align-items-center py-1 ps-3 pe-2 @(nextDisabled ? "disabled" : "")">
        Next
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right-icon lucide-chevron-right"><path d="m9 18 6-6-6-6" /></svg>
    </a>
</div>