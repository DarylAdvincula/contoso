@model ContosoUniversity.Models.Student

@{
    ViewData["Title"] = "Edit";
}

<h4>Edit Student Details</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FirstMidName" class="control-label"></label>
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnrollmentDate" class="control-label"></label>
                <input asp-for="EnrollmentDate" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Enrollments" class="control-label"></label>
                <div class="col-md-offset-2 col-md-10">
                    <table>
                        <tr>
                            @{
                                int count = 0;

                                List<ContosoUniversity.Models.SchoolViewModels.EnrolledCourseData> courses = ViewBag.Courses;

                                foreach (var course in courses)
                                {
                                    if (count++ % 3 == 0)
                                    {
                                        @:</tr><tr>
                                    }

                                    @:<td class="text-nowrap">
                                        <input
                                            id="@course.Id"
                                            type="checkbox"
                                            name="selectedCourses"
                                            value="@course.Id"
                                            @(course.Enrolled ? "checked" : "")
                                        />
                                        <label 
                                            for="@course.Id" 
                                            class="user-select-none"
                                        >
                                            @course.Id @course.Title
                                        </label>
                                    @:</td>
                                }
                                @:</tr>
                            }
                    </table>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
