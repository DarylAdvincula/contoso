@model ContosoUniversity.Page<Student>

@{
    ViewData["Title"] = "Students";

    // get search string
    var hasSearch = !String.IsNullOrEmpty(ViewData["SearchString"]?.ToString());

    // initialization of default null ViewData["X"]
    var lastSort = ViewData["LastSortOrder"]?.ToString() ?? "last_asc";
    var firstSort = ViewData["FirstSortOrder"]?.ToString() ?? "first_asc";
    var dateSort = ViewData["DateSortOrder"]?.ToString() ?? "date_latest";

    // determining disabled buttons
    var prevDisabled = !Model.HasPreviousPage;
    var nextDisabled = !Model.HasNextPage;
}

<h2 class="mb-4">Students</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            <label>Find by name: <input type="text" name="SearchString" value="@ViewData["SearchString"]" /></label>
            <input type="submit" value="Search" class="btn btn-default" /> |
            <a asp-action="Index" class="btn btn-default">Back to Full List</a>
        </p>
    </div>
</form>

<div class="table-responsive mt-4">
    <table class="table">
        <thead class="table-light">
            <tr>
                <th>
                    <div class="d-flex gap-1 justify-content-between">
                        <a 
                            asp-controller="Students" 
                            asp-action="Index"
                            asp-route-page="@Model.PageNumber"
                           asp-route-SearchString="@ViewData["SearchString"]"
                            asp-route-sortOrder="@(lastSort == "last_asc" ? "last_desc" : "last_asc")"
                           class="text-decoration-none d-flex align-items-center justify-content-between gap-2"
                        >
                            <span>Last Name</span>
                        </a>
                    </div>
                </th>
                <th>
                    <div class="d-flex gap-1 justify-content-between">
                        <a asp-controller="Students"
                            asp-action="Index"
                            asp-route-page="@Model.PageNumber"
                            asp-route-SearchString="@ViewData["SearchString"]"
                            asp-route-sortOrder="@(firstSort == "first_asc" ? "first_desc" : "first_asc")"
                            class="text-decoration-none d-flex align-items-center justify-content-between gap-2">
                            <span>First Name</span>
                        </a>
                    </div>
                </th>
                <th>
                    <div class="d-flex gap-1 justify-content-between">
                        <a 
                            asp-controller="Students" 
                            asp-action="Index"
                            asp-route-page="@Model.PageNumber"
                           asp-route-SearchString="@ViewData["SearchString"]"
                            asp-route-sortOrder="@(dateSort == "date_latest" ? "date_oldest" : "date_latest")"
                           class="text-decoration-none d-flex align-items-center justify-content-between gap-2">
                            <span>Enrollment Date</span>
                        </a>
                    </div>
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FirstMidName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EnrollmentDate)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p>Page @Model.PageNumber of @Model.TotalPages</p>

<div class="d-flex gap-2">
    <a 
        asp-controller="Students" 
        asp-action="Index"
        asp-route-sortOrder="@ViewData["SortOrder"]"
        asp-route-SearchString="@ViewData["SearchString"]"
        asp-route-page="@(Model.PageNumber - 1)"
       class="btn btn-default d-flex gap-2 align-items-center py-1 pe-3 ps-2 @(prevDisabled ? "disabled" : "")">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left-icon lucide-chevron-left"><path d="m15 18-6-6 6-6" /></svg>
        Prev
    </a>
    <a 
        asp-controller="Students"
        asp-action="Index"
        asp-route-sortOrder="@ViewData["SortOrder"]"
        asp-route-SearchString="@ViewData["SearchString"]"
        asp-route-page="@(Model.PageNumber + 1)"
        class="btn btn-default d-flex gap-2 align-items-center py-1 ps-3 pe-2 @(nextDisabled ? "disabled" : "")"
    >
        Next
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right-icon lucide-chevron-right"><path d="m9 18 6-6-6-6" /></svg>
    </a>
</div>