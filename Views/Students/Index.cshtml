@model ContosoUniversity.Page<Student>

@{
    ViewData["Title"] = "Index";

    // get search string
    var hasSearch = !String.IsNullOrEmpty(ViewData["SearchString"]?.ToString());

    // initialization of default null ViewData["X"]
    var lastSort = ViewData["LastSortOrder"]?.ToString() ?? "last_asc";
    var firstSort = ViewData["FirstSortOrder"]?.ToString() ?? "first_asc";
    var dateSort = ViewData["DateSortOrder"]?.ToString() ?? "date_latest";

    // determining disabled buttons based on total pages
    var prevDisabled = !Model.HasPreviousPage;
    var nextDisabled = !Model.HasNextPage;
}

<h2 class="mb-4">Students</h2>

<form 
    asp-controller="Students" 
    asp-action="Index" method="get" 
    class="d-flex gap-2"
>
    <!--preserve the sort order when searching a student-->
    <input 
        type="hidden" 
        name="sortOrder" 
        value="@ViewData["SortOrder"]"
    />
    <input 
        type="text" 
        name="searchString" 
        placeholder="Search Students"
        value="@ViewData["SearchString"]" 
        class="flex-grow-1 form-control"
    />
    @if (hasSearch)
    {
        <a asp-action="Index"
           class="text-decoration-none btn btn-danger d-flex text-nowrap gap-1 align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
            Clear
        </a>
    }
    <button
        type="submit"
        class="flex-grow-1 btn btn-primary d-flex align-items-center gap-1" 
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search"><path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" /></svg>
        Search
    </button>
    <a 
        asp-action="Create"
        class="text-decoration-none btn btn-success d-flex text-nowrap gap-1 align-items-center"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus-icon lucide-user-plus"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" x2="19" y1="8" y2="14" /><line x1="22" x2="16" y1="11" y2="11" /></svg>
        Add New
    </a>
</form>

<div class="table-responsive mt-4">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>
                    <div class="d-flex gap-1 justify-content-between">
                        Last Name
                        <a 
                            asp-controller="Students" 
                            asp-action="Index"
                            asp-route-page="@Model.PageNumber"
                            asp-route-sortOrder="@(lastSort == "last_asc" ? "last_desc" : "last_asc")"
                           class="text-decoration-none btn btn-primary py-0 px-1">
                            @if (lastSort == "last_asc")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up-icon lucide-chevron-up"><path d="m18 15-6-6-6 6" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6" /></svg>
                            }
                        </a>
                    </div>
                </th>
                <th>
                    <div class="d-flex gap-1 justify-content-between">
                        First Name
                        <a asp-controller="Students"
                           asp-action="Index"
                           asp-route-page="@Model.PageNumber"
                           asp-route-sortOrder="@(firstSort == "first_asc" ? "first_desc" : "first_asc")"
                           class="text-decoration-none btn btn-primary py-0 px-1">
                           @if(firstSort == "first_asc")
                            {   
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up-icon lucide-chevron-up"><path d="m18 15-6-6-6 6" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6" /></svg>
                            }
                        </a>
                    </div>
                </th>
                <th>
                    <div class="d-flex gap-1 justify-content-between">
                        Enrollment Date
                        <a 
                            asp-controller="Students" 
                            asp-action="Index"
                            asp-route-page="@Model.PageNumber"
                            asp-route-sortOrder="@(dateSort == "date_latest" ? "date_oldest" : "date_latest")"
                           class="text-decoration-none btn btn-primary py-0 px-1">
                            @if (dateSort == "date_latest")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up-icon lucide-chevron-up"><path d="m18 15-6-6-6 6" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6" /></svg>
                            }
                        </a>
                    </div>
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FirstMidName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EnrollmentDate)
                    </td>
                    <td class="d-flex gap-2">
                        <a 
                            asp-action="Edit" 
                            asp-route-id="@item.Id"
                            class="btn btn-primary py-1 d-flex gap-1 align-items-center"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-pen-icon lucide-user-pen"><path d="M11.5 15H7a4 4 0 0 0-4 4v2" /><path d="M21.378 16.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" /><circle cx="10" cy="7" r="4" /></svg>
                            Edit
                        </a>
                        <a 
                            asp-action="Details" 
                            asp-route-id="@item.Id"
                            class="btn btn-secondary py-1 d-flex gap-1 align-items-center"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                            Details
                        </a>
                        <a 
                            asp-action="Delete" 
                            asp-route-id="@item.Id"
                            class="btn btn-danger py-1 d-flex gap-1 align-items-center"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-minus-icon lucide-user-minus"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="22" x2="16" y1="11" y2="11" /></svg>
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex gap-2">
    <a 
        asp-controller="Students" 
        asp-action="Index"
        asp-route-sortOrder="@ViewData["SortOrder"]"
        asp-route-searchString="@ViewData["SearchString"]"
        asp-route-page="@(Model.PageNumber - 1)"
       class="btn btn-primary d-flex gap-2 align-items-center py-1 pe-3 ps-2 @(prevDisabled ? "disabled" : "")">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left-icon lucide-chevron-left"><path d="m15 18-6-6 6-6" /></svg>
        Prev
    </a>
    <a 
        asp-controller="Students"
        asp-action="Index"
        asp-route-sortOrder="@ViewData["SortOrder"]"
        asp-route-searchString="@ViewData["SearchString"]"
        asp-route-page="@(Model.PageNumber + 1)"
        class="btn btn-primary d-flex gap-2 align-items-center py-1 ps-3 pe-2 @(nextDisabled ? "disabled" : "")"
    >
        Next
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right-icon lucide-chevron-right"><path d="m9 18 6-6-6-6" /></svg>
    </a>
</div>